# .aiball.yaml is per-user / per-machine project config (autopoll tone,
# throttle, claude-loop wiring). Use .aiball.yaml.example as the
# committed template; copy on first install. #B.166
.aiball.yaml
# .aiball.local.yaml — #394 `claude-loop init` remote connection (carries a
# bearer token). Per-machine secret; never commit.
.aiball.local.yaml
# .mcp.json carries the per-user AIBALL_AGENT identity (consumer id) +
# project binding. Use .mcp.json.example as the committed template;
# copy + edit AIBALL_AGENT / AIBALL_PROJECT on first install. #B.166
.mcp.json
# .claude/ holds per-user Claude Code state (settings.local.json
# permission allowlist, agent cache). Never committed.
.claude/
# Python bytecode cache. The claude-loop PTY proxy is run with `python3
# -B` so this shouldn't appear, but ignore it defensively. #269
__pycache__/
*.pyc
# Build artifact of scripts/make-icon.py — for human verification
# only, the real icon is assets/aiball.ico.
assets/aiball-preview.png
# Rust build output for the Windows ConPTY proxy (#281, strategy B). The
# compiled cl-pty-proxy.exe is a platform-specific artifact built locally
# (or by install.ps1); never committed.
windows/cl-pty-proxy/target/
