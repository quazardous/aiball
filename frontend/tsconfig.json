{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": { "@shared/*": ["../src/*"] },
    "strict": true,
    "noUnusedLocals": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "useDefineForClassFields": true
  },
  "include": ["src/**/*", "src/**/*.vue", "vite.config.ts"],
  // rpc.test.ts runs the frontend's client against the real daemon: it imports
  // the backend, whose dependencies a frontend-only install does not have.
  "exclude": ["src/lib/rpc.test.ts"]
}
