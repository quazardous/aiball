# aiball per-project config (#B.99)
#
# Drop this file at your project root as `.aiball.yaml` to enable the
# autopoll hook (Stop event → "you have N aiball pings to drain").
# Without this file, the hook is inactive even if it's wired in
# ~/.claude/settings.json. Everything below is optional with sensible
# defaults — `{}` (empty YAML) is enough to turn autopoll on.
#
# Pilot from the CLI: `aiball autopoll enable|disable|tone X|throttle N`
# Inspect current state: `aiball check`

autopoll:
  # Master switch. The hook in ~/.claude/settings.json is global; this
  # is the per-project opt-in. Default when this file exists: true.
  enabled: true

  # Reminder behavior :
  #
  #   false (default) — persistent. The hook re-fires after
  #                     `throttle_seconds` even if you didn't drain.
  #                     New pings (max_id moves) always notify
  #                     immediately, bypassing the throttle.
  #   true            — one-shot. Notify only when a strictly newer
  #                     ping arrives (max_id watermark moves). No
  #                     time-based reminders — "tell me once and
  #                     leave me alone".
  volatile: false

  # Reminder cadence (ignored when volatile: true). 0 means "every
  # Stop"; with persistent mode that's spammy. Bumped #B.192 to 120s
  # so fast back-and-forth conversations (each turn ≪ 30s) don't
  # re-fire the standing reminder every turn — new pings and new
  # open tickets still bypass the throttle and notify instantly.
  # State persists in ~/.cache/aiball/autopoll-<agent>.json.
  throttle_seconds: 120

  # How aggressively the hook nudges the agent.
  #
  #   hint       — "Consider calling unread(...)." Polite, easy to ignore.
  #                Use when the agent's own system prompt already
  #                handles proactivity.
  #   directive  — "Drain via unread(...) then react. Do not ask first."
  #                Default. Names the action explicitly.
  #   imperative — "**YOU MUST** drain N pings BEFORE doing anything."
  #                Last resort if the agent persists in asking
  #                permission patterns.
  tone: directive

  # Include up to N recent unread ticket titles in the hook's reason,
  # so the agent knows what's waiting before draining. 0 = count only.
  include_recent_tickets: 3

  # Open-tickets count handling :
  #
  #   true (default) — the count is also a trigger: notify when open
  #                    tickets exist in your scope, even without unread
  #                    pings. New open tickets bump the watermark.
  #   false          — context only: the count is still displayed in
  #                    the reason if there are pings, but doesn't
  #                    trigger by itself.
  backlog: true

# Identity — consumer_id and project for this project. The CANONICAL
# source (#B.154 — david: ".aiball.yaml est la source canonique").
# Resolution chain across every aiball tool (autopoll, claude-loop,
# `aiball` CLI, MCP server):
#
#   1. `AIBALL_AGENT` / `AIBALL_PROJECT` env  ← priority override.
#                                               Reserved for special
#                                               cases (shell scripts
#                                               running as another
#                                               identity, one-off
#                                               scopes). Don't use as
#                                               the everyday setting.
#   2. `consumer:` block here                 ← canonical, recommended
#   3. `.mcp.json` mcpServers.aiball.env      ← DEPRECATED. Still
#                                               works, but `aiball
#                                               check` + claude-loop
#                                               warn. Migrate.
#   4. Defaults                                project: basename(cwd)
#                                              agent: <project>-claude
#
# Set the `consumer:` block once here and you stop maintaining the
# values in `.mcp.json`'s env block (which only ever reached the MCP
# subprocess anyway — not claude-loop or the bash CLI).
#
# consumer:
#   agent: skybot-claude
#   project: skybot

# claude-loop timeouts (#B.180). All optional — the defaults below
# are what ship today. CLI flags (`--interval`, `--user-grace`) still
# win over yaml when explicitly passed.
#
# claude_loop:
#   # Heartbeat tick in seconds. Lower = bar more reactive + faster
#   # polling-fallback, higher = less daemon load. Default 30
#   # (recalibrated #B.185 — old 60s was sluggish enough that the
#   # bar lagged visibly behind real state changes).
#   interval_seconds: 30
#
#   # Boot-grace before settleBoot fires. The pane-probe can sortir
#   # du `[boot]` plus tôt si elle detecte le prompt. Default 60.
#   boot_grace_seconds: 60
#
#   # User-grace window after a human prompt — tryWake refuses to
#   # send-keys during this period. Default 60 (aligned on the
#   # heartbeat / boot-grace order, #B.185).
#   user_grace_seconds: 60
#
#   # #305: boot-grace WAIT default when NEITHER --wait nor --no-wait is
#   # passed on `claude-loop start`. The global CLI default stays no-wait
#   # (#343: eager boot drain). Set true here so THIS project's loops boot
#   # in `wait` (yield the boot-grace for a human take-over) without typing
#   # --wait each time. An explicit --wait/--no-wait still overrides. Default false.
#   wait: false
#
#   # Wake-in-flight TTL (#B.180): how long the marker stays "fresh"
#   # after the timer touches it pre-send-keys. The UserPromptSubmit
#   # hook checks this to distinguish auto-wake from human input.
#   # Default 2000 (2s) — only reduce if your shell is faster than
#   # 2s round-trip on send-keys → hook fire.
#   wake_in_flight_ttl_ms: 2000
#
#   # ESC takeover (#345). When ON, pressing ESC in the loop pane (the
#   # gesture you use to interrupt claude / take over) arms the
#   # user-grace window — the loop stops auto-pinging for
#   # `user_grace_seconds` so it doesn't barge back in over you, and the
#   # tmux bar reads `wait`. ESC is otherwise invisible to the wrapper
#   # (it's a control byte, not a prompt submit). Requires the PTY proxy
#   # (the default launch path; without it ESC can't be detected).
#   # Default true — set false to keep ESC purely a claude interrupt
#   # with no effect on the loop.
#   esc_takeover: true
#
#   # AskUserQuestion gate (#351). In a loop, the multi-choice dialog is
#   # allowed only if a human acted within ask_grace_seconds; past that it
#   # redirects the agent to ask via a ticket comment. Longer than
#   # user_grace_seconds — a stalled question is cheap vs a lost one.
#   # Default 600 (10 min).
#   ask_grace_seconds: 600
#
#   # AFK combo (#351): press it to TOGGLE yourself away/back IMMEDIATELY (the
#   # AskUserQuestion gate redirects while away, without waiting for the timeout);
#   # resuming typing also clears it ("I'm back"). #381: the combo flips
#   # away↔back, is robust to the keys arriving coalesced in one read, and
#   # forgets its state after each toggle — a stray repeat ESC within
#   # afk_window_ms is ignored, so a single later press can't re-toggle.
#   # VS Code notation: `+` joins
#   # modifiers, a space = a 2-combo sequence (e.g. "esc esc", "ctrl+a").
#   # Only what the terminal emits as distinct bytes is supported (esc,
#   # ctrl+<char>, f-keys, literals). Requires the PTY proxy. Default "esc esc".
#   afk_key: "esc esc"
#
#   # Max milliseconds between the two combos of an afk_key sequence
#   # (ignored for a single combo). Default 400.
#   afk_window_ms: 400

# Workflow hints (#319). claude-loop "habille" the WAKE of a `feature`-intent
# ticket with a branch hint ("🌿 Feature: build it in …, not on main."). Lets
# you tune the wording per project without forcing a workflow; layered like
# claude_loop (defaults → this file). request/other intents get no hint.
# workflow:
#   # Hint to build feature tickets on a dedicated branch + PR. Default false.
#   hint_branch: false
#   # Also mention a git worktree (too technical). Default false.
#   hint_worktree: false
#   # (both false → no branch hint on feature wakes; opt in per project)

# Wake-CTA / state-prompt template overrides (#B.232 cpaez7).
# Optional per-project section. When absent, the skill-shipped defaults
# in `config/defaults/claude-loop-pings.yaml` apply — you don't need anything here
# for the wake-CTA to work. Use this block to localize wording (FR/EN),
# experiment with directiveness levels, or tune the prompt for a project
# with multiple agents talking to claude.
#
# Resolution chain (#B.232 7bxrr2): three layers, project wins.
#
#   1. Shipped defaults — at `config/defaults/claude-loop-pings.yaml`.
#                        Read at every wake by the central service.
#   2. Global per-user — optional, at `$XDG_CONFIG_HOME/aiball/config.yaml`
#                       or `~/.config/aiball/config.yaml`. Use this when
#                       you want the SAME wording across every project
#                       you work on (e.g. an "always-FR" preference).
#   3. Per-project — this file's `prompts:` block. Overrides global +
#                    defaults, slot by slot.
#
# Slot-grain replace at each step (no deep merge inside a slot, so a
# user can switch shape forms freely between layers).
#
# Each slot accepts THREE shapes (russian-doll optional):
#
#   string                  → no variation, identical at every tone.
#                             Easiest form when you have one canonical
#                             wording you trust.
#   list[string]             → random pick from the pool every wake.
#                              Use to inject variety so the prompt
#                              feels less mechanical.
#   { tone: list[string] }   → russian-doll, per-imperativity pool.
#                              Tone comes from `autopoll.tone` above
#                              (hint | directive | imperative). Missing
#                              tone in the map → falls back to `directive`.
#                              Each tone gets its own list (random
#                              pick within).
#
# Placeholders substituted at render time (slot-specific):
#
#   {ping_count}    integer (e.g. 3)
#   {open_count}    integer (count of actionable tickets)
#   {project_scope} "`<project>`" or "your scope"
#
# Pluralization (#B.232 hd7taf): when a slot's wording depends on a
# count, split into TWO keys instead of using a `{plural}` placeholder.
# The picker looks at the runtime count and chooses automatically:
#
#   {slot}_one     used when count === 1
#   {slot}_other   used when count !== 1
#
# The plain `{slot}` (no suffix) acts as a no-variant fallback when
# the yaml only defines one form. Variants support the same 3 shapes
# (string, list, object{tone:list}). Useful for languages with
# pluralization beyond a trailing "s": French agreement on multiple
# words ("1 ping aiball non lu" vs "3 pings aiball non lus"), gendered
# articles, "no tickets" zero-case (treated like _other by default).
#
# Slot reference (all wake-CTA pieces — the central service composes
# them via the `wake_master` assembly template, falling back to a
# hardcoded `{culture} {lead} {state}. {directive}.` shape):
#
#   wake_master            → assembly template. Composes the rendered
#                            sub-parts. Supports placeholders:
#                            {culture} (random pop-culture ping —
#                            auto-resolved from ping_messages),
#                            {lead}, {state}, {directive}.
#                            Use the list shape to vary the sentence
#                            structure across wakes.
#   wake_state_lead        → conversational lead between the culture
#                            phrase and the state report. Replaces the
#                            old `[aiball: ...]` bracket framing that
#                            tripped prompt-injection defenses on cold
#                            sessions (david 6ehkvn).
#   wake_state_pings       → state part for unread pings.
#   wake_state_open        → state part for open tickets.
#   wake_directive_drain   → imperative verb for the drain action.
#   wake_directive_engage  → imperative verb for the engage action.
#
# Magic placeholder (#B.232 jdhdxq): `{culture}` resolves to a random
# pick from `ping_messages` (the pop-culture phrase pool defined in
# `skill/claude-loop-pings.yaml`). Drop it into any slot — wake_master
# leads with it by default, but a custom wake_state_lead like
# `"{culture}, fyi:"` also works.
#
# A missing slot in the override falls back to the skill defaults; a
# slot in the override REPLACES the default for that slot (no deep merge
# inside a slot, so you can switch shape forms freely).
#
# prompts:
#   wake_state_lead:
#     directive:
#       - "fyi:"
#       - "heads up —"
#       - "quick note:"
#     hint: ["btw,", "fyi,"]
#     imperative: ["**heads up**:", "**ACTION**:"]
#
#   # 2-slug pluralization (#B.232 hd7taf).
#   wake_state_pings_one:   "1 unread aiball ping"
#   wake_state_pings_other: "{ping_count} unread aiball pings"
#
#   # List form (random pick, identical at every tone).
#   wake_directive_drain:
#     - "drain via `unread({pings: true, mark_read: true})`"
#     - "ack via `unread({pings: true, mark_read: true})`"

# Ticket-text linkifier patterns (#B.235). Same 3-layer chain as
# `prompts:` — shipped defaults at `config/defaults/claude-loop-pings.yaml`,
# global at `~/.config/aiball/config.yaml`, per-project here. Merge is by
# `id`: shipped defaults are non-removable (they always run as fallback);
# entries here either OVERRIDE a default by reusing the same id, or ADD
# a new linkifier with a fresh id.
#
# Regex is validated at load (`new RegExp(match)`). Invalid entries log
# to stderr and are dropped — the rest of the merge still ships.
#
# Fields:
#   id         stable identifier
#   match      ECMAScript regex source
#   canonical  visible label template — `{1}`, `{2}` reference capture
#              groups (1-indexed). `{0}` = whole match.
#   href       optional URL template (same `{N}` syntax). Captures are
#              URL-encoded before insertion. When omitted, the match is
#              styled but not wrapped in <a>.
#   class      optional CSS class on the rendered element
#
# Example overrides:
#
# formatting:
#   patterns:
#     # Override the canonical form of an existing pattern (id=ticket).
#     - id: ticket
#       match: "#[Bb][._/-]?(\\d+)\\b"
#       canonical: "[B-{1}]"
#       href: "/b/{1}"
#       class: "ticket-ref"
#
#     # Add a project-specific pattern (e.g. JIRA references).
#     - id: jira
#       match: "\\b(PROJ-\\d+)\\b"
#       canonical: "{1}"
#       href: "https://jira.example.com/browse/{1}"
#       class: "external-ref"

# Config-defined tags (#223). Tags declared here show up in the Tags
# admin panel as READ-ONLY entries (a lock badge, no delete) next to the
# DB tags you create from the UI. Use them to ship a curated component
# catalog (`claude-code`, `mcp`, `daemon`, `hook`, …) that can't be
# accidentally deleted.
#
# Inheritance is COMPOSITE — every layer ADDS (unlike `prompts:` /
# `formatting:`, which replace slot-by-slot). Three layers, low→high:
#   0. shipped dist    — `config/defaults/tags.yaml` (the classic catalog:
#                        bug / feature / urgent / … — read-only, ships with
#                        the install)
#   1. global per-user — `~/.config/aiball/config.yaml` → tags:
#   2. per-project     — this file's `tags:` block
#
# A tag's display order follows the LAST layer that mentions it (restate
# a tag to move it to the end); color/note carry over from earlier layers
# when a later one omits them.
#
# Each entry is a bare name or an object with optional `color` / `note`:
#   - claude-code
#   - { name: mcp, color: "#7e57c2", note: "MCP server surface" }
#
# PER-PROJECT scope: the daemon resolves config from a SINGLE cwd, so it
# only ever reads ONE project's `.aiball.yaml`. To declare tags for other
# projects (the Tags panel has a project selector spanning all of them),
# use the project-keyed map in the GLOBAL file:
#
#   # ~/.config/aiball/config.yaml
#   tags:
#     global:                      # apply to every project
#       - bug
#       - { name: mcp, color: "#7e57c2" }
#     projects:
#       aiball: [frontend, daemon, hook]
#       m2m:    [{ name: datamart, note: "BI sync" }]
#
# In THIS per-project file, a bare list is shorthand for "tags for this
# project" (it won't leak to siblings):
#
# tags:
#   - claude-code
#   - { name: hook, color: "#0ea5e9", note: "settings.json hooks" }
