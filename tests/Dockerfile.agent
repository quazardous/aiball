# #981 Slice 1 — full-stack scenario AGENT image.
#
# Runs the REAL claude-loop stack (loop.ts timer + PTY proxy + hooks) inside a
# container, driving `fake-claude` as the (only) faked component, pointed at the
# `daemon` service over HTTP (data-plane remote, REMOTE.md "Direct" model).
#
# Native better-sqlite3 is compiled INSIDE the image (host node_modules can't be
# reused across ABIs) — mirrors tests/Dockerfile. The source is bind-mounted at
# run time; an anonymous volume preserves the compiled node_modules.
# The PTY proxy, built for THIS image. The checkout is bind-mounted at run time,
# and its own `windows/cl-pty-proxy/target` (if any) was built on the host, whose
# libc this image may not have: the loop is pointed at this build instead
# (CL_PROXY_BIN below). Same Debian as node:22-slim. `build.rs` reads the
# version from package.json, hence the copy.
FROM rust:1-slim-bookworm AS proxy
WORKDIR /build
COPY package.json ./package.json
COPY windows/cl-pty-proxy ./windows/cl-pty-proxy
RUN cargo build --release --locked --manifest-path windows/cl-pty-proxy/Cargo.toml

FROM node:22-slim
WORKDIR /app

# Toolchain : better-sqlite3 native compile (g++/make/python3) + the runtime
# the agent needs — tmux (the loop wraps claude in tmux), python3 (fake-claude),
# curl (daemon wait), procps (pid checks).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-pip make g++ tmux curl ca-certificates procps \
    && rm -rf /var/lib/apt/lists/*

# Python deps — textual / pyyaml : fake-claude (invoked via `python3
# bin/fake-claude`, no uv). --break-system-packages : Debian PEP-668.
RUN pip install --no-cache-dir --break-system-packages \
        "textual>=0.50" "pyyaml>=6"

COPY --from=proxy /build/windows/cl-pty-proxy/target/release/cl-pty-proxy /opt/cl-pty-proxy/cl-pty-proxy
ENV CL_PROXY_BIN=/opt/cl-pty-proxy/cl-pty-proxy
# #3066 — the session host, for the host-mode scenarios (the daemon starts it).
COPY --from=proxy /build/windows/cl-pty-proxy/target/release/cl-session-host /opt/cl-pty-proxy/cl-session-host
ENV CL_SESSION_HOST_BIN=/opt/cl-pty-proxy/cl-session-host

COPY package.json package-lock.json ./
RUN npm ci

# Source (incl. tests/agent-entrypoint.sh) is bind-mounted at /app at run time.
ENTRYPOINT ["/app/tests/agent-entrypoint.sh"]
