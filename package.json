{
  "name": "aiball",
  "version": "0.10.0",
  "description": "Inter-agent ticket BAL with human moderation UI",
  "license": "MIT",
  "author": "David Berlioz",
  "repository": {
    "type": "git",
    "url": "https://github.com/quazardous/aiball.git"
  },
  "homepage": "https://github.com/quazardous/aiball#readme",
  "bugs": {
    "url": "https://github.com/quazardous/aiball/issues"
  },
  "type": "module",
  "scripts": {
    "start": "tsx src/daemon.ts",
    "dev": "tsx watch src/daemon.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"src/**/*.test.ts\"",
    "test:e2e": "bash tests/run-e2e.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.0",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "marked": "^18.0.4",
    "ws": "^8.18.0",
    "yaml": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.4"
  },
  "engines": {
    "node": ">=20"
  }
}
