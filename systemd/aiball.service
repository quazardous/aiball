[Unit]
Description=aiball — inter-agent ticket BAL daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/aiball
# The daemon has its own entrypoint (#1567): `npx --no-install tsx …/src/daemon.ts`
# only resolved inside a checkout with dev dependencies installed, and npx had to
# find tsx by walking up from the working directory.
ExecStart=%h/.local/lib/aiball/bin/aiball-daemon
# #354: bring up enabled+autostart remote-access providers (tailscale, …)
# when the daemon starts. No-op when no `providers:` block is configured in
# ~/.config/aiball/config.yaml. Leading `-` = never fail the unit on this.
ExecStartPost=-/usr/bin/env %h/.local/bin/aiball providers up
Restart=on-failure
RestartSec=2
Environment=AIBALL_HOST=127.0.0.1
Environment=AIBALL_PORT=7777

[Install]
WantedBy=default.target
