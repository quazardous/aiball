#!/usr/bin/env bash
# aiball-tailscale — wrap `tailscale serve` for the local aiball daemon.
# Auto-resolves the port (AIBALL_PORT env → systemd bind drop-in → 7777).
#
#   aiball-tailscale up                 # HTTPS on 443 (needs MagicDNS HTTPS)
#   aiball-tailscale up --http          # plain HTTP on 80 (no certs)
#   aiball-tailscale up --port 8443     # HTTPS on a custom port
#   aiball-tailscale down               # remove all serve config
#   aiball-tailscale status             # show current serve config + URL
#
# Full manual + security model: docs/TAILSCALE.md.
set -eo pipefail

DROPIN="$HOME/.config/systemd/user/aiball.service.d/bind.conf"

resolve_port() {
    if [[ -n "${AIBALL_PORT:-}" ]]; then echo "$AIBALL_PORT"; return; fi
    if [[ -f "$DROPIN" ]]; then
        local p; p="$(grep -oE 'AIBALL_PORT=[0-9]+' "$DROPIN" | tail -n1 | cut -d= -f2)"
        if [[ -n "$p" ]]; then echo "$p"; return; fi
    fi
    echo 7777
}

require_tailscale() {
    command -v tailscale >/dev/null 2>&1 \
        || { echo "tailscale not found — install from https://tailscale.com/download" >&2; exit 1; }
    tailscale status >/dev/null 2>&1 \
        || { echo "tailscale not logged in — run: sudo tailscale up" >&2; exit 1; }
}

print_url() {
    local scheme="$1" listen="$2"
    local host; host="$(tailscale status --json 2>/dev/null \
        | grep -oE '"DNSName":\s*"[^"]+"' | head -n1 | cut -d'"' -f4 | sed 's/\.$//' || true)"
    if [[ -z "$host" ]]; then
        host="$(tailscale ip -4 2>/dev/null | head -n1)"
    fi
    [[ -n "$host" ]] || { echo "(could not resolve tailnet hostname)"; return; }
    case "$listen" in
        443|80) echo "  ${scheme}://${host}/" ;;
        *)      echo "  ${scheme}://${host}:${listen}/" ;;
    esac
}

cmd_up() {
    local use_http=false listen=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --http)        use_http=true; shift ;;
            --port)        listen="${2:-}"; shift 2 ;;
            --port=*)      listen="${1#--port=}"; shift ;;
            -h|--help)     sed -n '1,/^set -e/p' "$0" | sed 's/^# \?//'; exit 0 ;;
            *) echo "unknown flag: $1" >&2; exit 1 ;;
        esac
    done
    require_tailscale
    local port; port="$(resolve_port)"
    local target="127.0.0.1:${port}"
    if $use_http; then
        : "${listen:=80}"
        echo "[+] tailscale serve --bg --http=${listen} ${target}"
        tailscale serve --bg --http="${listen}" "${target}"
        print_url http "${listen}"
    else
        : "${listen:=443}"
        echo "[+] tailscale serve --bg --https=${listen} ${target}"
        if ! tailscale serve --bg --https="${listen}" "${target}"; then
            echo "[!] HTTPS serve failed — MagicDNS + HTTPS certs may not be enabled." >&2
            echo "    Retry with: $(basename "$0") up --http" >&2
            exit 1
        fi
        print_url https "${listen}"
    fi
}

cmd_down() {
    require_tailscale
    echo "[+] tailscale serve reset"
    tailscale serve reset
}

cmd_status() {
    require_tailscale
    tailscale serve status || true
}

# Print the aiball version (source of truth: repo-root package.json, the
# qcmp `aiball` component). Resolves through the ~/.local/bin symlink.
print_version() {
    local self="$0"
    while [[ -L "$self" ]]; do
        local t; t="$(readlink "$self")"
        if [[ "$t" = /* ]]; then self="$t"; else self="$(dirname "$self")/$t"; fi
    done
    local root; root="$(cd "$(dirname "$self")/.." && pwd)"
    local v; v="$(grep -m1 '"version"' "$root/package.json" 2>/dev/null \
        | sed -E 's/.*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')"
    echo "${v:-unknown}"
}

case "${1:-}" in
    up)     shift; cmd_up "$@" ;;
    down)   shift; cmd_down ;;
    status) shift; cmd_status ;;
    -v|--version|version) print_version ;;
    -h|--help|"")
        sed -n '1,/^set -e/p' "$0" | sed 's/^# \?//'
        ;;
    *) echo "unknown subcommand: $1" >&2; exit 1 ;;
esac
