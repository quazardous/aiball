#!/usr/bin/env bash
# claude-loop — generic terminal wrapper that makes a Claude Code
# session "tickable": idle-detect via Stop hook + periodic check-cmd
# poll in a timer pane that wakes the session via tmux send-keys
# whenever idle AND check-cmd reports a new event (#B.63 v1).
#
# v1: 60s poll fallback only. Sub-minute reactivity = follow-up
# (swap timer to a unix socket the daemon-side watcher writes to).
#
# Usage:
#   claude-loop start --name NAME [--interval N] [--check-cmd CMD]
#                     [--pings YAML] [--attach]
#   claude-loop list
#   claude-loop attach NAME
#   claude-loop tail NAME [--lines N]
#   claude-loop rm NAME [--force]
#   claude-loop wake NAME      # v1 noop placeholder
#   claude-loop prune
set -eo pipefail

STATE_ROOT="${CLAUDE_LOOP_STATE_ROOT:-$HOME/.claude-loop}"
MUX_CMD="${MUX_CMD:-tmux}"
DEFAULT_INTERVAL=60
SELF="$0"
while [[ -L "$SELF" ]]; do
    target="$(readlink "$SELF")"
    if [[ "$target" = /* ]]; then SELF="$target"; else SELF="$(dirname "$SELF")/$target"; fi
done
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
ROOT="$(cd "$BIN_DIR/.." && pwd)"
SKILL_DIR="$ROOT/skill"

die() { echo "claude-loop: $1" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

state_dir() { echo "$STATE_ROOT/$1"; }
tmux_name() { echo "cl-$1"; }
tmux_alive() { $MUX_CMD has-session -t "$(tmux_name "$1")" 2>/dev/null; }

cmd_start() {
    # Loop flags come before `--`; everything after `--` is passed
    # through to the spawned `claude` (per david: "il faut pouvoir
    # passer des options à claude derrière"). E.g.:
    #   claude-loop --name foo --interval 90 -- --model opus -p "..."
    local name="" interval="$DEFAULT_INTERVAL" check_cmd="" pings="" attach=0
    local claude_args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --) shift; claude_args=("$@"); break ;;
            --name) name="$2"; shift 2 ;;
            --interval) interval="$2"; shift 2 ;;
            --check-cmd) check_cmd="$2"; shift 2 ;;
            --pings) pings="$2"; shift 2 ;;
            --attach) attach=1; shift ;;
            *) die "unknown flag: $1  (claude options go after \`--\`)" ;;
        esac
    done
    [[ -z "$name" ]] && name="cl-$(date +%s)-$$"
    local sd; sd="$(state_dir "$name")"
    [[ -e "$sd" ]] && die "loop '$name' already exists at $sd"
    need "$MUX_CMD"; need jq; need curl

    mkdir -p "$sd"
    # Default pings YAML — user can override with --pings /path/to/file.
    [[ -z "$pings" ]] && pings="$SKILL_DIR/claude-loop-pings.yaml"
    [[ -f "$pings" ]] || die "pings file not found: $pings"
    cp "$pings" "$sd/pings.yaml"

    # Build the inline Claude Code settings JSON with the Stop hook
    # that marks idle-since when a turn ends with no actionable work.
    local stop_hook="$SKILL_DIR/claude-loop-stop.sh"
    [[ -x "$stop_hook" ]] || die "stop hook not executable: $stop_hook"
    local settings_json
    settings_json=$(jq -n --arg cmd "$stop_hook" '{
        hooks: {
            Stop: [{ hooks: [{ type: "command", command: $cmd }] }]
        }
    }')

    # Env file sourced by the Stop hook + timer.
    cat > "$sd/env" <<EOF
export CL_NAME="$name"
export CL_STATE_DIR="$sd"
export CL_INTERVAL="$interval"
export CL_CHECK_CMD="${check_cmd:-true}"
export CL_PINGS="$sd/pings.yaml"
EOF

    local tname; tname="$(tmux_name "$name")"
    # Pane 0 (only pane): claude itself. The Stop hook + permission-
    # mode are always injected; any user-supplied claude args after
    # `--` are appended verbatim. Shell-escape each one so spaces /
    # quotes round-trip safely.
    local claude_passthrough=""
    for arg in "${claude_args[@]:-}"; do
        [[ -z "$arg" ]] && continue
        claude_passthrough+=" $(printf %q "$arg")"
    done
    local inner
    inner="source '$sd/env'; exec claude --permission-mode auto --settings $(printf %q "$settings_json")${claude_passthrough}"
    $MUX_CMD new-session -d -s "$tname" -c "$PWD" bash -lc "$inner"
    # Timer = a detached background process, NOT a tmux pane (david:
    # "le double écran ça sert à rien et ça catch les touches"). The
    # timer logs to $sd/timer.log so it's still inspectable via
    # `claude-loop tail-timer` if we add that, or just `tail -f` on
    # the file directly.
    local timer_script="$SKILL_DIR/claude-loop-timer.sh"
    [[ -x "$timer_script" ]] || die "timer script not executable: $timer_script"
    (
        source "$sd/env"
        nohup "$timer_script" > "$sd/timer.log" 2>&1 &
        echo "$!" > "$sd/timer.pid"
    )
    # Status bar so a loop session is visually distinct (cyan).
    $MUX_CMD set-option -t "$tname" status-bg colour39 >/dev/null 2>&1 || true
    $MUX_CMD set-option -t "$tname" status-fg colour15 >/dev/null 2>&1 || true
    $MUX_CMD set-option -t "$tname" status-left " CLAUDE-LOOP · $name " >/dev/null 2>&1 || true
    $MUX_CMD set-option -t "$tname" status-left-length 60 >/dev/null 2>&1 || true
    # Kick claude into action after the SessionStart settles.
    ( sleep 3 && $MUX_CMD send-keys -t "$tname.0" "ready when you are" Enter ) >/dev/null 2>&1 &

    cat <<EOF
loop '$name' started
  state:    $sd
  interval: ${interval}s
  check:    ${check_cmd:-<none — pure timer>}
  attach:   $MUX_CMD attach -t $tname   (or: claude-loop attach $name)
EOF
    [[ $attach -eq 1 ]] && exec $MUX_CMD attach -t "$tname"
}

cmd_list() {
    [[ -d "$STATE_ROOT" ]] || { echo "(no loops)"; return; }
    local found=0
    for sd in "$STATE_ROOT"/*/; do
        [[ -d "$sd" ]] || continue
        local name; name="$(basename "$sd")"
        local tname; tname="$(tmux_name "$name")"
        local alive="dead"; tmux_alive "$name" && alive="alive"
        local idle="—"
        [[ -f "$sd/idle-since" ]] && idle="idle since $(cat "$sd/idle-since")"
        printf "%-30s  %-5s  %s\n" "$name" "$alive" "$idle"
        found=1
    done
    [[ $found -eq 0 ]] && echo "(no loops)"
}

cmd_attach() {
    local name="$1"
    [[ -z "$name" ]] && die "usage: claude-loop attach NAME"
    tmux_alive "$name" || die "loop '$name' is not alive"
    exec $MUX_CMD attach -t "$(tmux_name "$name")"
}

cmd_tail() {
    local name="$1" lines=40 source="pane"
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --lines) lines="$2"; shift 2 ;;
            --timer) source="timer"; shift ;;
            *) shift ;;
        esac
    done
    [[ -z "$name" ]] && die "usage: claude-loop tail NAME [--lines N] [--timer]"
    local sd; sd="$(state_dir "$name")"
    if [[ "$source" = "timer" ]]; then
        [[ -f "$sd/timer.log" ]] || die "no timer log at $sd/timer.log"
        tail -n "$lines" "$sd/timer.log"
        return
    fi
    tmux_alive "$name" || die "loop '$name' not alive (use --timer to inspect the timer log)"
    $MUX_CMD capture-pane -t "$(tmux_name "$name").0" -p | tail -n "$lines"
}

cmd_rm() {
    local name="$1"; shift || true
    local force=0
    [[ "${1:-}" = "--force" ]] && force=1
    [[ -z "$name" ]] && die "usage: claude-loop rm NAME [--force]"
    local sd; sd="$(state_dir "$name")"
    $MUX_CMD kill-session -t "$(tmux_name "$name")" 2>/dev/null || true
    # Kill the detached timer process if its pid file is still around.
    if [[ -f "$sd/timer.pid" ]]; then
        kill "$(cat "$sd/timer.pid")" 2>/dev/null || true
    fi
    if [[ -d "$sd" ]]; then
        rm -rf "$sd"
        echo "removed loop '$name'"
    else
        [[ $force -eq 1 ]] || die "no state dir at $sd (use --force to silence)"
    fi
}

cmd_wake() {
    local name="$1"
    [[ -z "$name" ]] && die "usage: claude-loop wake NAME"
    tmux_alive "$name" || die "loop '$name' not alive"
    # v1: bypass the check-cmd, just force a tick by clearing idle-since
    # so the timer fires on its next 60s pass. Sub-second wake = v2
    # (socket-driven). Documenting clearly per david.
    local sd; sd="$(state_dir "$name")"
    rm -f "$sd/idle-since"
    touch "$sd/wake-requested"
    echo "wake requested for '$name' (will fire at next timer tick, up to ${DEFAULT_INTERVAL}s)"
}

cmd_prune() {
    [[ -d "$STATE_ROOT" ]] || { echo "(nothing)"; return; }
    local orphans=()
    for sd in "$STATE_ROOT"/*/; do
        [[ -d "$sd" ]] || continue
        local name; name="$(basename "$sd")"
        tmux_alive "$name" || orphans+=("$name")
    done
    if [[ ${#orphans[@]} -eq 0 ]]; then
        echo "nothing to prune"
        return
    fi
    echo "orphan state dirs (no tmux): ${orphans[*]}"
    read -rp "remove them? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { echo "aborted"; return; }
    for n in "${orphans[@]}"; do rm -rf "$(state_dir "$n")"; done
    echo "pruned ${#orphans[@]} orphan(s)"
}

case "${1:-}" in
    start)   shift; cmd_start "$@" ;;
    list)    cmd_list ;;
    attach)  shift; cmd_attach "$@" ;;
    tail)    shift; cmd_tail "$@" ;;
    rm)      shift; cmd_rm "$@" ;;
    wake)    shift; cmd_wake "$@" ;;
    prune)   cmd_prune ;;
    -h|--help|help)
        cat <<'EOF'
claude-loop — wrap a Claude Code session in a tmux loop that wakes
itself when idle if a check-cmd reports new work (#B.63 v1).

Default invocation (no subcommand) = `start`:
  claude-loop [--name N] [--interval 60] [--check-cmd CMD] [--pings YAML]
              [--attach] [-- CLAUDE_ARGS...]

Anything after `--` is passed verbatim to the spawned `claude`.
Example:
  claude-loop --name oncall --interval 90 -- --model opus -p "start drain"

Lifecycle subcommands:
  list
  attach NAME
  tail NAME [--lines N] [--timer]   (--timer = timer log instead of claude pane)
  rm NAME [--force]
  wake NAME    (v1: bumps the timer; sub-minute reactivity is v2 via socket)
  prune

The timer runs as a detached background process (logs at
~/.claude-loop/<NAME>/timer.log) — no longer a tmux pane, so it
doesn't catch keystrokes when you attach.
EOF
        ;;
    "")
        # No args at all = start a loop with all defaults.
        cmd_start
        ;;
    *)
        # Any other first arg is treated as a `start` flag (or the
        # `--` passthrough separator). Falls into cmd_start which
        # will reject genuinely unknown flags.
        cmd_start "$@"
        ;;
esac
