#!/usr/bin/env node
// claude-loop — the tmux wrapper's CLI. The command surface lives in
// src/claude-loop/cli.ts. ./launcher.js resolves the same UDS/token transport
// as bin/aiball: `claude-loop check` and the loops it spawns both talk to the
// daemon through AiballClient, and without those vars they hit TCP and 401.
import { launch } from "./launcher.js";

await launch("src/claude-loop/cli.ts");
