#!/usr/bin/env bash
# aiball — CLI for the inter-agent BAL daemon.
# Spool fallback: if the daemon is unreachable, POST /messages requests are
# dropped as JSON in $AIBALL_HOME/spool/ and replayed when the daemon comes up.
set -eo pipefail

URL="${AIBALL_URL:-http://127.0.0.1:7777}"
AIBALL_HOME="${AIBALL_HOME:-$HOME/.local/share/aiball}"
SPOOL_DIR="$AIBALL_HOME/spool"
TIMEOUT="${AIBALL_TIMEOUT:-2}"

err() { printf 'aiball: %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }

need() {
    command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"
}
need curl
need jq
need sha256sum

# Stable consumer id for the agent in the current working directory.
# Override via AIBALL_AGENT env var if you want explicit naming.
consumer_id() {
    if [[ -n "${AIBALL_AGENT:-}" ]]; then
        printf '%s' "$AIBALL_AGENT"
    else
        # printf without newline to match the TS client's hash
        printf '%s' "$(pwd -P)" | sha256sum | cut -c1-12
    fi
}

# Default `by_agent` for posts. Falls back to consumer_id if AIBALL_AGENT
# is not set, so a CLI invocation always carries some identity.
default_by() {
    consumer_id
}

# Resolve a project name from --project flag or $AIBALL_PROJECT, dying
# with a useful message if neither is set.
resolve_project() {
    local p="${1:-}"
    if [[ -n "$p" ]]; then
        printf '%s' "$p"
    elif [[ -n "${AIBALL_PROJECT:-}" ]]; then
        printf '%s' "$AIBALL_PROJECT"
    else
        die "project required: pass --project P or set AIBALL_PROJECT"
    fi
}

usage() {
    cat <<'EOF'
Usage:
  aiball ticket new     --project P --title T [--body B] [--by AGENT]
  aiball ticket comment --id N --body B [--by AGENT] [--parent N]
  aiball ticket close   --id N [--by AGENT]
  aiball ticket list    [--project P] [--status pending|approved|rejected]
  aiball ticket get     <id>

  aiball rule list
  aiball rule add       --decision auto|review [--project P] [--kind K] [--by AGENT] [--note N]
  aiball rule del       <id>
  aiball rule enable    <id>
  aiball rule disable   <id>

  aiball project list
  aiball feed-path      <project>

  aiball whoami                       # prints the consumer_id used here
  aiball subscribe      <project> [--catchup]
  aiball unsubscribe    <project>
  aiball subs                         # list this consumer's subscriptions
  aiball unread         [--project P] [--limit N]
  aiball mark-read      --project P (--up-to N | --all)

  aiball status                       # daemon up? data dir? spool size?
  aiball drain                        # ask daemon to flush spool now (no-op if down)

Env:
  AIBALL_URL      default http://127.0.0.1:7777
  AIBALL_HOME     default ~/.local/share/aiball
  AIBALL_AGENT    consumer_id override (default sha256(pwd)[:12])
  AIBALL_PROJECT  default --project value (recommended in .mcp.json env)
  AIBALL_TIMEOUT  default 2 (seconds, HTTP attempts)
EOF
}

# --- HTTP helpers ----------------------------------------------------------

http_get() {
    local path="$1"
    curl -sfS --max-time "$TIMEOUT" "$URL$path"
}

http_send() {
    local method="$1" path="$2" body="${3:-}"
    if [[ -n "$body" ]]; then
        curl -sfS --max-time "$TIMEOUT" -X "$method" \
            -H "content-type: application/json" \
            -d "$body" "$URL$path"
    else
        curl -sfS --max-time "$TIMEOUT" -X "$method" "$URL$path"
    fi
}

spool_drop() {
    local body="$1"
    mkdir -p "$SPOOL_DIR"
    local ts rnd tmp final
    ts="$(date +%s%N)"
    rnd="$RANDOM-$$"
    tmp="$SPOOL_DIR/.${ts}-${rnd}.tmp"
    final="$SPOOL_DIR/${ts}-${rnd}.json"
    printf '%s' "$body" > "$tmp"
    mv "$tmp" "$final"
    err "daemon unreachable, queued to $final"
    jq -nc --arg file "$final" '{queued:true, file:$file}'
}

post_message_with_fallback() {
    local body="$1"
    if out="$(http_send POST /api/messages "$body" 2>/dev/null)"; then
        printf '%s\n' "$out"
    else
        spool_drop "$body"
    fi
}

# --- JSON builders (jq) ----------------------------------------------------

# build_msg <project> <kind> <title> <body> <by> <ticket_id> <parent_id>
build_msg() {
    jq -nc \
        --arg project "$1" --arg kind "$2" --arg title "$3" \
        --arg body "$4" --arg by "$5" --arg ticket_id "$6" --arg parent_id "${7:-}" \
        '{project:$project, kind:$kind}
         + (if $title    != "" then {title:$title}                  else {} end)
         + (if $body     != "" then {body:$body}                    else {} end)
         + (if $by       != "" then {by_agent:$by}                  else {} end)
         + (if $ticket_id!= "" then {ticket_id:($ticket_id|tonumber)}   else {} end)
         + (if $parent_id!= "" then {parent_id:($parent_id|tonumber)}   else {} end)'
}

# --- arg parser ------------------------------------------------------------

# parse_kvs --foo bar --baz qux --flag ...
# Hyphens in keys become underscores. Bare --flag (followed by another --flag
# or end-of-args) sets the value to "true" so booleans work without a value.
declare -A KV
parse_kvs() {
    KV=()
    while (($#)); do
        case "$1" in
            --*=*)
                local k="${1%%=*}"; k="${k#--}"; k="${k//-/_}"
                KV["$k"]="${1#*=}"
                shift
                ;;
            --*)
                local k="${1#--}"; k="${k//-/_}"
                if [[ $# -lt 2 || "${2:-}" == --* ]]; then
                    KV["$k"]="true"
                    shift
                else
                    KV["$k"]="$2"
                    shift 2
                fi
                ;;
            *)
                die "unexpected positional argument: $1"
                ;;
        esac
    done
}

# --- subcommands -----------------------------------------------------------

cmd_ticket_new() {
    parse_kvs "$@"
    [[ -n "${KV[title]:-}" ]] || die "ticket new: --title required"
    local project; project="$(resolve_project "${KV[project]:-}")"
    local body
    body="$(build_msg \
        "$project" "ticket_created" \
        "${KV[title]}" "${KV[body]:-}" "${KV[by]:-$(default_by)}" "" "")"
    post_message_with_fallback "$body"
}

cmd_ticket_comment() {
    parse_kvs "$@"
    [[ -n "${KV[id]:-}" ]]   || die "ticket comment: --id required"
    [[ -n "${KV[body]:-}" ]] || die "ticket comment: --body required"

    local project="${KV[project]:-}"
    if [[ -z "$project" ]]; then
        # Try to infer from running daemon
        if t="$(http_get "/api/messages/${KV[id]}" 2>/dev/null)"; then
            project="$(jq -r '.project' <<<"$t")"
        elif [[ -n "${AIBALL_PROJECT:-}" ]]; then
            project="$AIBALL_PROJECT"
        else
            die "ticket comment: --project required (daemon down, can't infer; or set AIBALL_PROJECT)"
        fi
    fi
    local parent="${KV[parent]:-${KV[id]}}"   # default reply target = ticket root
    local body
    body="$(build_msg \
        "$project" "comment_added" \
        "" "${KV[body]}" "${KV[by]:-$(default_by)}" "${KV[id]}" "$parent")"
    post_message_with_fallback "$body"
}

cmd_ticket_close() {
    parse_kvs "$@"
    [[ -n "${KV[id]:-}" ]] || die "ticket close: --id required"
    local project="${KV[project]:-}"
    if [[ -z "$project" ]]; then
        if t="$(http_get "/api/messages/${KV[id]}" 2>/dev/null)"; then
            project="$(jq -r '.project' <<<"$t")"
        elif [[ -n "${AIBALL_PROJECT:-}" ]]; then
            project="$AIBALL_PROJECT"
        else
            die "ticket close: --project required (daemon down, can't infer; or set AIBALL_PROJECT)"
        fi
    fi
    local body
    body="$(build_msg \
        "$project" "ticket_closed" \
        "" "" "${KV[by]:-$(default_by)}" "${KV[id]}" "${KV[id]}")"
    post_message_with_fallback "$body"
}

cmd_ticket_list() {
    parse_kvs "$@"
    local q=""
    [[ -n "${KV[project]:-}" ]] && q+="${q:+&}project=$(jq -rn --arg s "${KV[project]}" '$s|@uri')"
    if [[ -n "${KV[status]:-}" ]]; then
        q+="${q:+&}status=$(jq -rn --arg s "${KV[status]}" '$s|@uri')&kind=ticket_created"
        http_get "/api/messages?$q"
    else
        http_get "/api/tickets${q:+?$q}"
    fi
}

cmd_ticket_get() {
    [[ $# -eq 1 ]] || die "ticket get: <id> required"
    http_get "/api/tickets/$1"
}

cmd_rule_list() { http_get "/api/rules"; }

cmd_rule_add() {
    parse_kvs "$@"
    [[ -n "${KV[decision]:-}" ]] || die "rule add: --decision required"
    local body
    body="$(jq -nc \
        --arg decision "${KV[decision]}" \
        --arg project  "${KV[project]:-}" \
        --arg kind     "${KV[kind]:-}" \
        --arg by       "${KV[by]:-}" \
        --arg note     "${KV[note]:-}" \
        '{decision:$decision}
         + (if $project != "" then {match_project:$project}      else {} end)
         + (if $kind    != "" then {match_kind:$kind}            else {} end)
         + (if $by      != "" then {match_by_agent:$by}          else {} end)
         + (if $note    != "" then {note:$note}                  else {} end)')"
    http_send POST /api/rules "$body"
}

cmd_rule_del() {
    [[ $# -eq 1 ]] || die "rule del: <id> required"
    http_send DELETE "/api/rules/$1"
}

cmd_rule_toggle() {
    local val="$1"; shift
    [[ $# -eq 1 ]] || die "rule (en|dis)able: <id> required"
    http_send PATCH "/api/rules/$1" "$(jq -nc --argjson e "$val" '{enabled:$e}')"
}

cmd_project_list() { http_get "/api/projects"; }

cmd_feed_path() {
    [[ $# -eq 1 ]] || die "feed-path: <project> required"
    if r="$(http_get "/api/feed-path?project=$(jq -rn --arg s "$1" '$s|@uri')" 2>/dev/null)"; then
        jq -r '.path' <<<"$r"
    else
        # Daemon down — compute it locally (matches paths.ts logic)
        if [[ ! "$1" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
            die "invalid project name: $1"
        fi
        printf '%s/outbox/%s.jsonl\n' "$AIBALL_HOME" "$1"
    fi
}

cmd_whoami() {
    jq -nc --arg id "$(consumer_id)" --arg cwd "$(pwd -P)" \
        --arg project "${AIBALL_PROJECT:-}" \
        '{consumer_id:$id, cwd:$cwd, source:(env.AIBALL_AGENT // "sha256(pwd)"),
          default_project:(if $project=="" then null else $project end)}'
}

cmd_subscribe() {
    local project="" catchup="false"
    while (($#)); do
        case "$1" in
            --catchup) catchup="true"; shift ;;
            --*)       die "subscribe: unknown flag $1" ;;
            *)         project="$1"; shift ;;
        esac
    done
    project="$(resolve_project "$project")"

    local cid; cid="$(consumer_id)"
    local fp;  fp="$(cmd_feed_path "$project")"

    local sub_json
    if sub_json="$(http_send POST /api/subscriptions \
        "$(jq -nc --arg cid "$cid" --arg p "$project" --argjson c "$catchup" \
              '{consumer_id:$cid, project:$p, catchup:$c}')" 2>/dev/null)"; then
        :
    else
        sub_json='{"warning":"daemon unreachable, subscription not registered"}'
    fi

    jq -n \
        --argjson sub "$sub_json" \
        --arg cid "$cid" \
        --arg project "$project" \
        --arg fp "$fp" \
        '{
            consumer_id: $cid,
            project: $project,
            feed_path: $fp,
            subscription: $sub,
            monitor_command: "tail -F -n 0 \($fp)"
        }'
}

cmd_unsubscribe() {
    local project; project="$(resolve_project "${1:-}")"
    local cid; cid="$(consumer_id)"
    local enc_cid enc_proj
    enc_cid="$(jq -rn --arg s "$cid" '$s|@uri')"
    enc_proj="$(jq -rn --arg s "$project" '$s|@uri')"
    http_send DELETE "/api/subscriptions?consumer_id=$enc_cid&project=$enc_proj"
    jq -nc --arg cid "$cid" --arg project "$project" \
        '{unsubscribed:true, consumer_id:$cid, project:$project}'
}

cmd_subs() {
    local cid; cid="$(consumer_id)"
    local enc; enc="$(jq -rn --arg s "$cid" '$s|@uri')"
    http_get "/api/subscriptions?consumer_id=$enc"
}

cmd_unread() {
    parse_kvs "$@"
    local project; project="$(resolve_project "${KV[project]:-}")"
    local cid; cid="$(consumer_id)"
    local enc_cid enc_proj
    enc_cid="$(jq -rn --arg s "$cid" '$s|@uri')"
    enc_proj="$(jq -rn --arg s "$project" '$s|@uri')"
    local q="consumer_id=$enc_cid&project=$enc_proj"
    [[ -n "${KV[limit]:-}" ]] && q+="&limit=${KV[limit]}"
    http_get "/api/unread?$q"
}

cmd_mark_read() {
    parse_kvs "$@"
    local project; project="$(resolve_project "${KV[project]:-}")"
    local cid; cid="$(consumer_id)"
    local body
    if [[ "${KV[all]:-}" == "true" || "${KV[all]:-}" == "1" ]]; then
        body="$(jq -nc --arg cid "$cid" --arg p "$project" \
            '{consumer_id:$cid, project:$p, all:true}')"
    elif [[ -n "${KV[up_to]:-}" ]]; then
        body="$(jq -nc --arg cid "$cid" --arg p "$project" \
            --arg upto "${KV[up_to]}" \
            '{consumer_id:$cid, project:$p, up_to_id:($upto|tonumber)}')"
    else
        die "mark-read: provide --up-to N or --all"
    fi
    http_send POST /api/mark-read "$body"
}

cmd_status() {
    local up="false" daemon_info="null"
    if r="$(http_get /api/health 2>/dev/null)"; then
        up="true"
        daemon_info="$r"
    fi
    local spool_count=0
    [[ -d "$SPOOL_DIR" ]] && spool_count="$(find "$SPOOL_DIR" -maxdepth 1 -name '*.json' -type f 2>/dev/null | wc -l)"
    jq -nc \
        --argjson up "$up" \
        --arg url "$URL" \
        --arg home "$AIBALL_HOME" \
        --argjson spool "$spool_count" \
        --argjson info "$daemon_info" \
        '{daemon_up:$up, url:$url, home:$home, spool_pending:$spool, daemon:$info}'
}

cmd_drain() {
    # The daemon watches the spool dir; touching a file forces it to re-scan.
    # If the daemon is down, this is a no-op (files stay queued).
    if [[ -d "$SPOOL_DIR" ]]; then
        local marker="$SPOOL_DIR/.drain-trigger"
        : > "$marker" && rm -f "$marker"
    fi
    cmd_status
}

# --- dispatcher ------------------------------------------------------------

if [[ $# -eq 0 ]]; then usage; exit 0; fi

case "$1" in
    -h|--help|help) usage; exit 0 ;;
    ticket)
        shift
        case "${1:-}" in
            new)     shift; cmd_ticket_new "$@" ;;
            comment) shift; cmd_ticket_comment "$@" ;;
            close)   shift; cmd_ticket_close "$@" ;;
            list)    shift; cmd_ticket_list "$@" ;;
            get)     shift; cmd_ticket_get "$@" ;;
            *) die "unknown ticket subcommand: ${1:-(none)}" ;;
        esac
        ;;
    rule)
        shift
        case "${1:-}" in
            list)    shift; cmd_rule_list ;;
            add)     shift; cmd_rule_add "$@" ;;
            del)     shift; cmd_rule_del "$@" ;;
            enable)  shift; cmd_rule_toggle 1 "$@" ;;
            disable) shift; cmd_rule_toggle 0 "$@" ;;
            *) die "unknown rule subcommand: ${1:-(none)}" ;;
        esac
        ;;
    project)
        shift
        case "${1:-}" in
            list)  cmd_project_list ;;
            *) die "unknown project subcommand: ${1:-(none)}" ;;
        esac
        ;;
    feed-path)   shift; cmd_feed_path "$@" ;;
    whoami)      cmd_whoami ;;
    subscribe)   shift; cmd_subscribe "$@" ;;
    unsubscribe) shift; cmd_unsubscribe "$@" ;;
    subs)        cmd_subs ;;
    unread)      shift; cmd_unread "$@" ;;
    mark-read)   shift; cmd_mark_read "$@" ;;
    status)      cmd_status ;;
    drain)       cmd_drain ;;
    *) die "unknown command: $1" ;;
esac
