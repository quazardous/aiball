#!/usr/bin/env bash
# aiball — thin launcher that resolves the install root and execs the TS
# CLI via tsx. The actual command surface lives in src/cli.ts.
set -eo pipefail

# Resolve through symlinks (e.g. ~/.local/bin/aiball → install dir).
SELF="$0"
while [[ -L "$SELF" ]]; do
    target="$(readlink "$SELF")"
    if [[ "$target" = /* ]]; then SELF="$target"; else SELF="$(dirname "$SELF")/$target"; fi
done
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"
ROOT="$(cd "$BIN_DIR/.." && pwd)"

cd "$ROOT"
exec npx --no-install tsx "$ROOT/src/cli.ts" "$@"
