#!/usr/bin/env node
// aiball MCP server — stdio transport. Honors AIBALL_URL / AIBALL_HOME /
// AIBALL_AGENT (see README). ./launcher.js keeps the caller's PWD in
// AIBALL_CWD so the welcome resolver finds the right `.aiball.yaml` by walking
// up from the project the agent was launched in.
import { launch } from "./launcher.js";

await launch("src/mcp.ts");
