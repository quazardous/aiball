#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["textual>=0.50", "pyyaml>=6"]
# ///
"""fake-claude — scriptable claude(1) simulator for claude-loop debugging.

Reads a YAML scenario and plays it through a `textual` TUI app so the
prompt input and the streaming output have their OWN widgets (each owns
its region — no cursor/repaint parasitage, the bug that killed the rich
V0.1, #605 nups2s).

Architecture (Vertical layout):
    ┌──────────────────────────────────────────────────┐
    │ Static  : "✻ Working…"  /  ""  (boot/busy hint)  │   ← dynamic header
    ├──────────────────────────────────────────────────┤
    │ RichLog : echoes + streamed lines, scrollable    │   ← own region
    ├──────────────────────────────────────────────────┤
    │ Input   : `❯ ` composer (cursor lives here)      │   ← own region
    ├──────────────────────────────────────────────────┤
    │ Static  : "⏵⏵ auto mode on · esc to interrupt"   │   ← state footer
    └──────────────────────────────────────────────────┘

Markers preserved VERBATIM in their widgets so claude-loop's pane-probe
regexes (state.ts:1018 `esc to interrupt`, session-start-hook.ts:116
`Resume session`+`Space to preview`, etc.) match on tmux capture-pane:
the regex doesn't care WHO rendered the bytes, only that they're on
screen. textual writes them straight via Static/RichLog.

Shebang uses `uv run --script` with PEP-723 inline deps (`textual`,
`pyyaml`) so the deps are auto-resolved into a cached venv on first
run — single-file script, no manual pip.
"""
from __future__ import annotations

import argparse
import asyncio
import random
import sys
from pathlib import Path

import yaml
from textual import on
from textual.app import App, ComposeResult
from textual.containers import Vertical
from textual.widgets import Input, RichLog, Static


# Markers the claude-loop pane probe regexes expect (verbatim).
MARKER_ESC_INTERRUPT = "esc to interrupt"
MARKER_AUTO_MODE = "⏵⏵ auto mode on (shift+tab to cycle)"
MARKER_RESUME_TITLE = "Resume session"
MARKER_RESUME_HINT = "Space to preview"


# Lorem ipsum, line-per-salvo (1-3 s between each in the stream).
LOREM_IPSUM_LINES = [
    "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
    "Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
    "Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.",
    "Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.",
    "Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.",
    "Curabitur pretium tincidunt lacus. Nulla gravida orci a odio.",
    "Nullam varius, turpis et commodo pharetra, est eros bibendum elit, nec luctus magna felis sollicitudin mauris.",
    "Integer in mauris eu nibh euismod gravida. Duis ac tellus et risus vulputate vehicula.",
]


# Built-in screen specs. A YAML scenario can declare its own under
# `screens:`. Each spec is one of these kinds — the textual app
# dispatches on `kind`:
#
#   kind=header_flash : update the header to <text> for <duration> s
#                       then clear. Used for `✻ Loading Claude…`,
#                       `*  Resuming conversation…`, etc.
#   kind=write        : push <text> as one line into the output log.
#   kind=picker       : push a multi-line block (resume picker), set
#                       header `[choose a session]`, wait for the
#                       next Input.Submitted, then clear.
#   kind=prompt       : suspend the play-loop until the user submits
#                       a line via Input.Submitted. The submitted line
#                       is echo'd into the log as `> {input}`.
#   kind=stream       : header → busy marker, push <lines> into the
#                       log one by one with random <delay_min>/<delay_max>
#                       between, then header cleared.
#
# duration is optional; defaults to 1.0 for header_flash.

BUILTIN_SCREENS: dict[str, dict] = {
    "boot.loading": {
        "kind": "header_flash",
        "text": "✻ Loading Claude…",
        "duration": 1.0,
    },
    "boot.resume_picker": {
        "kind": "picker",
        # Verbatim from david's #605 ezq3ea capture. Both regex
        # markers (Resume session / Space to preview) are present.
        "lines": [
            MARKER_RESUME_TITLE,
            "",
            "    skybot",
            "",
            "  ❯ Review open issues in skybot",
            "    1 minute ago · main · 8.9MB",
            "",
            "    Engage ticket 478 in skybot",
            "    2 days ago · main · 968.7KB",
            "",
            "    Process AIball pings and engage work ticket",
            "    2 days ago · main · 1.1MB",
            "",
            f"    Ctrl+A to show all projects · Ctrl+B to only show current branch · {MARKER_RESUME_HINT} · Ctrl+R to rename · Type to search · Esc to cancel",
        ],
    },
    "transition.resuming": {
        "kind": "header_flash",
        # Double space `*  Resuming` verbatim (b9crta).
        "text": "*  Resuming conversation…",
        "duration": 2.0,
    },
    # Faithful to real claude: during a /compact the "Compacting
    # conversation…" line + a ▰▱ progress bar sit in the FOOTER zone (just
    # above the input), NOT a top header. The loop's compacting detector
    # (compacting-detector.ts) is footer-scoped — it needs the ▰▱ bar (or an
    # end-of-line %) within the last lines — so a header-only marker is
    # invisible to it (the reason compacting-detect.yaml was xfail). The
    # `compacting` kind renders the whole marker (text + bar) into the footer
    # for `duration` s, then restores the auto-mode footer.
    "transition.compacting": {
        "kind": "compacting",
        "text": "✶ Compacting conversation…",
        "bar": "▰▰▰▱▱▱▱▱▱▱ 34%",
        "duration": 3.0,
    },
    # The "Compact this conversation?" picker claude shows right after a resume
    # pick, before the actual compact runs. The loop's CompactConfirmWatcher is
    # footer-scoped (last 12 non-empty lines). Written into the transcript so it
    # persists in scrollback — faithful to the live bug where, after a short
    # resume+compact, the line stays inside the 12-line footer window at idle
    # and the `compact_confirm` boot module never ends → boot never seals.
    "transition.compact_confirm": {
        "kind": "compact_confirm",
        "text": "Compact this conversation? [Y/n]",
        "duration": 2.0,
    },
    "transition.crunched": {
        "kind": "header_flash",
        "text": "✻ Crunched for 47s",
        "duration": 0.5,
    },
    "main.idle": {
        "kind": "prompt",
    },
    "main.busy": {
        "kind": "header_flash",
        "text": f"✽ Working…   {MARKER_ESC_INTERRUPT}",
        "duration": 10.0,
    },
    "main.streaming_output": {
        "kind": "stream",
        "lines": LOREM_IPSUM_LINES,
        "delay_min": 1.0,
        "delay_max": 3.0,
        "max_lines": 6,
    },
}


# #605 david `p2hsng` : default scenario relative to the binary.
DEFAULT_SCENARIO_PATH = Path(__file__).resolve().parent.parent / "examples" / "fake-claude" / "scenarios" / "default.yaml"


def select_hook_commands(settings: dict, event: str, matcher=None) -> list:
    """Which commands Claude Code would run for `event`.

    Pure, and separated from the spawning so it can be tested without a loop,
    a TTY or a subprocess. Mirrors Claude Code's rule: every entry whose
    matcher fits, and an empty matcher fits everything. `matcher=None` means
    "whatever the scenario did not pin", so all entries run; passing one pins
    a single branch, which is how a scenario exercises `SessionStart:compact`
    without also firing `startup`.
    """
    out = []
    for entry in settings.get("hooks", {}).get(event, []) or []:
        if matcher is not None and entry.get("matcher", "") != matcher:
            continue
        for hook in entry.get("hooks", []) or []:
            if hook.get("type") == "command" and hook.get("command"):
                out.append(hook["command"])
    return out


class FakeClaudeApp(App):
    """Textual app — fakes claude's interactive UI for claude-loop debugging.

    The play loop runs as an async task launched on_mount; widgets are
    queried by id from the task. Input.Submitted fires a future that the
    prompt step awaits so the play loop yields control to the textual
    event loop while waiting for the user.
    """

    CSS = """
    Screen { background: $surface; }
    #header {
        height: 1;
        color: $accent;
        padding: 0 1;
    }
    #output {
        height: 1fr;
        border: solid $primary 30%;
        padding: 0 1;
    }
    #prompt {
        height: 3;
        border: round $primary;
    }
    #footer {
        height: 1;
        color: $text-muted;
        padding: 0 1;
    }
    """

    # #605 david `tq86bm` : "ctrl-d x2 pour quitter ?" — bash-style.
    # Ctrl+D fires `confirm_quit` ; un 2e Ctrl+D dans les 2s quitte.
    # Premier appui : hint dans le header. Ctrl+Q reste le shortcut
    # direct (textual standard).
    BINDINGS = [
        ("ctrl+d", "confirm_quit", "Quit (×2)"),
        ("ctrl+q", "quit", "Quit"),
    ]

    def __init__(self, screens: dict, steps: list) -> None:
        super().__init__()
        self.screens = screens
        self.steps = steps
        self._pending_input: asyncio.Future[str] | None = None
        self._quit_armed_until: float = 0.0

    def compose(self) -> ComposeResult:
        yield Vertical(
            Static("", id="header"),
            RichLog(id="output", wrap=True, highlight=False, markup=False, auto_scroll=True),
            Input(id="prompt", placeholder="❯"),
            Static(f"  {MARKER_AUTO_MODE} · ← for agents", id="footer"),
        )

    def on_mount(self) -> None:
        self.query_one("#prompt", Input).focus()
        # Kick off the scenario play loop as a task.
        self.run_worker(self._run_steps(), exclusive=True, group="scenario")

    @on(Input.Submitted, "#prompt")
    def on_input_submitted(self, event: Input.Submitted) -> None:
        line = event.value
        event.input.value = ""
        if self._pending_input is not None and not self._pending_input.done():
            self._pending_input.set_result(line)
        else:
            # Stray Enter outside a prompt step — just echo it.
            self.query_one("#output", RichLog).write(f"> {line}")

    async def _wait_for_input(self) -> str:
        loop = asyncio.get_event_loop()
        self._pending_input = loop.create_future()
        try:
            return await self._pending_input
        finally:
            self._pending_input = None

    async def _set_header(self, text: str) -> None:
        self.query_one("#header", Static).update(text)

    async def _write(self, text: str) -> None:
        self.query_one("#output", RichLog).write(text)

    async def _play_screen(self, spec: dict) -> None:
        kind = spec.get("kind")
        if kind == "header_flash":
            await self._set_header(spec.get("text", ""))
            await asyncio.sleep(float(spec.get("duration", 1.0)))
            await self._set_header("")
        elif kind == "compacting":
            # Render the compacting marker + ▰▱ progress bar into the FOOTER
            # zone (where real claude shows it, and where the loop's
            # footer-scoped detector looks), hold for `duration`, then
            # restore the normal auto-mode footer so the latch can release.
            text = spec.get("text", "✶ Compacting conversation…")
            bar = spec.get("bar", "▰▰▰▱▱▱▱ 34%")
            footer = self.query_one("#footer", Static)
            await self._set_header(text)
            footer.update(f"  {text} {bar}   {MARKER_ESC_INTERRUPT}")
            await asyncio.sleep(float(spec.get("duration", 3.0)))
            await self._set_header("")
            footer.update(f"  {MARKER_AUTO_MODE} · ← for agents")
        elif kind == "compact_confirm":
            # "Compact this conversation?" picker. Write into the transcript
            # (persists in scrollback) AND surface it in the footer so the
            # footer-scoped CompactConfirmWatcher sees it ; then restore the
            # footer. The transcript line lingering in the post-compact footer
            # window is the live bug we reproduce.
            text = spec.get("text", "Compact this conversation? [Y/n]")
            footer = self.query_one("#footer", Static)
            await self._write(text)
            footer.update(f"  {text}")
            await asyncio.sleep(float(spec.get("duration", 2.0)))
            footer.update(f"  {MARKER_AUTO_MODE} · ← for agents")
        elif kind == "write":
            await self._write(spec.get("text", ""))
        elif kind == "picker":
            await self._set_header("[choose a session — type 1/2/3 + Enter]")
            for line in spec.get("lines", []):
                await self._write(line)
            await self._wait_for_input()
            await self._set_header("")
        elif kind == "prompt":
            line = await self._wait_for_input()
            await self._write(f"> {line}")
        elif kind == "stream":
            await self._set_header(f"✻ Working…   {MARKER_ESC_INTERRUPT}")
            lines = spec.get("lines") or LOREM_IPSUM_LINES
            dmin = float(spec.get("delay_min", 1.0))
            dmax = float(spec.get("delay_max", 3.0))
            max_lines = int(spec.get("max_lines", len(lines)))
            for i, ln in enumerate(lines):
                if i >= max_lines:
                    break
                if i > 0:
                    await asyncio.sleep(random.uniform(dmin, dmax))
                await self._write(ln)
            await self._set_header("")
        else:
            await self._write(f"[fake-claude] unknown screen kind: {kind!r}")

    async def _fire_hook(self, step: dict) -> None:
        """Fire a Claude Code hook the way Claude Code would.

        The simulator painted screens and nothing else, which mirrored the
        wrong half of aiball: pane text is the layer being migrated AWAY from,
        while `Stop`, `Notification` and friends — the layer being migrated TO
        — could not be exercised at all without a real Claude and real luck.
        Some of them cannot be provoked on demand even then: nobody can make
        an API error, or a quota pause, happen when they want one.

        Fidelity matters more than convenience here, so the command is read
        from the `claude-settings.json` claude-loop actually generated rather
        than reconstructed. A reimplementation would drift from the real wiring
        and the drift would look like a passing test.

        The payload is whatever the scenario declares, plus the fields every
        event carries. Nothing is invented: a hook that receives a field the
        real one never sends would teach us something false.
        """
        import json as _json
        import os as _os
        import subprocess as _sp

        spec = step["hook"]
        if isinstance(spec, str):
            spec = {"event": spec}
        event = str(spec.get("event", "")).strip()
        if not event:
            await self._write("[fake-claude] 'hook' needs an event name")
            return

        sd = _os.environ.get("CL_STATE_DIR")
        name = _os.environ.get("CL_NAME")
        if not sd:
            await self._write("[fake-claude] hook: no CL_STATE_DIR — run me under claude-loop")
            return

        settings_path = _os.path.join(sd, "claude-settings.json")
        try:
            with open(settings_path) as fh:
                entries = _json.load(fh).get("hooks", {}).get(event, [])
        except OSError as exc:
            await self._write(f"[fake-claude] hook: cannot read {settings_path}: {exc}")
            return

        matcher = spec.get("matcher")
        payload = {
            "session_id": _os.environ.get("CLAUDE_SESSION_ID", "fake-claude"),
            "cwd": _os.getcwd(),
            "hook_event_name": event,
            **(spec.get("payload") or {}),
        }
        raw = _json.dumps(payload)

        fired = 0
        for command in select_hook_commands({"hooks": {event: entries}}, event, matcher):
            if True:
                try:
                    proc = _sp.run(
                        command, shell=True, input=raw, text=True,
                        capture_output=True, timeout=30,
                        env={**_os.environ, "CL_STATE_DIR": sd, **({"CL_NAME": name} if name else {})},
                    )
                    fired += 1
                    await self._write(f"[fake-claude] hook {event} → exit {proc.returncode}")
                except Exception as exc:  # a simulator must not die on a hook
                    await self._write(f"[fake-claude] hook {event} failed: {exc}")
        if fired == 0:
            await self._write(f"[fake-claude] hook {event}: no matching handler in claude-settings.json")

    async def _play_steps(self, steps: list) -> None:
        for step in steps:
            if "sleep" in step:
                await asyncio.sleep(float(step["sleep"]))
            elif "print" in step:
                await self._write(step["print"].rstrip("\n"))
            elif "screen" in step:
                slug = step["screen"]
                spec = self.screens.get(slug)
                if spec is None:
                    await self._write(f"[fake-claude] unknown screen '{slug}'")
                    continue
                await self._play_screen(spec)
            elif "hook" in step:
                await self._fire_hook(step)
            elif "loop" in step:
                inner = step["loop"]
                if not isinstance(inner, list):
                    await self._write("[fake-claude] 'loop' expects a list of steps")
                    continue
                times = step.get("times")
                remaining = int(times) if times is not None else None
                while remaining is None or remaining > 0:
                    await self._play_steps(inner)
                    if remaining is not None:
                        remaining -= 1
            else:
                await self._write(f"[fake-claude] unknown step {step!r}")

    async def _run_steps(self) -> None:
        try:
            await self._play_steps(self.steps)
        except asyncio.CancelledError:
            pass

    def action_confirm_quit(self) -> None:
        """Ctrl+D once : arm + show hint. Within 2 s, a second Ctrl+D
        actually quits — bash style. Outside the window, re-arms."""
        import time as _t
        now = _t.monotonic()
        if now < self._quit_armed_until:
            self.exit()
        else:
            self._quit_armed_until = now + 2.0
            self.query_one("#header", Static).update(
                "Press Ctrl+D again within 2 s to quit (or Ctrl+Q)"
            )
            self.set_timer(2.0, lambda: self.query_one("#header", Static).update(""))


# #637 Slice 1 — built-in PROBE scenarios. Each scenario is a list of
# (screen_slug, advance_on) tuples. The probe runner renders the screen
# at index 0 to stdout immediately, then loops reading stdin lines ;
# when the advance_on condition matches (typically a blank line = Enter,
# or a specific token), it advances to the next index. Reaching the end
# of the list = quit cleanly. The TUI textual app is bypassed entirely.
#
# Adding a scenario : just append a list of screen slugs (each must
# resolve in BUILTIN_SCREENS) ; the advance is "any line" by default.
# Sub-second timings (header_flash duration, stream delays) are
# ignored in probe mode — tests drive sequencing explicitly via stdin.
PROBE_SCENARIOS: dict[str, list[str]] = {
    # The session picker is on screen ; an Enter on stdin advances to
    # the idle prompt (simulates the session-start-hook auto-pick).
    "picker-2-sessions": ["boot.resume_picker", "main.idle"],
    # Compacting screen alone — the probe loop holds it until any
    # stdin line, then advances to the idle prompt.
    "compacting-42": ["transition.compacting", "main.idle"],
    # Plain ready state — useful as a baseline.
    "prompt-ready": ["main.idle"],
}


def _render_screen_sync(spec: dict, out=sys.stdout) -> None:
    """#637 Slice 1 — sync render of a screen spec to `out` (no event
    loop, no textual widgets). Used by probe-mode so claude-loop's
    capture-pane regex sees the same markers without the TUI overhead.
    Sub-second timings (`duration`, `delay_min/max`) are ignored —
    the test drives sequencing via stdin advance commands instead."""
    kind = spec.get("kind")
    if kind == "header_flash":
        out.write(spec.get("text", "") + "\n")
    elif kind == "compacting":
        # Marker + ▰▱ bar on consecutive lines so the footer-scoped detector
        # sees both the "Compacting conversation" text and the progress bar.
        text = spec.get("text", "✶ Compacting conversation…")
        bar = spec.get("bar", "▰▰▰▱▱▱▱ 34%")
        out.write(text + "\n")
        out.write(f"{bar}   {MARKER_ESC_INTERRUPT}\n")
    elif kind == "compact_confirm":
        out.write(spec.get("text", "Compact this conversation? [Y/n]") + "\n")
    elif kind == "write":
        out.write(spec.get("text", "") + "\n")
    elif kind == "picker":
        out.write("[choose a session — type 1/2/3 + Enter]\n")
        for line in spec.get("lines", []):
            out.write(line + "\n")
    elif kind == "prompt":
        out.write(f"❯ \n  {MARKER_AUTO_MODE}\n")
    elif kind == "stream":
        out.write(f"✽ Working…   {MARKER_ESC_INTERRUPT}\n")
        lines = spec.get("lines") or LOREM_IPSUM_LINES
        max_lines = int(spec.get("max_lines", len(lines)))
        for i, ln in enumerate(lines):
            if i >= max_lines:
                break
            out.write(ln + "\n")
    else:
        out.write(f"[fake-claude] unknown screen kind: {kind!r}\n")
    out.flush()


def _run_probe_mode(scenario_name: str, screens: dict) -> int:
    """#637 Slice 1 — non-event-loop runner for `--probe-mode SCENARIO`.
    Renders the first screen, then reads stdin line by line ; each line
    advances to the next screen in the scenario. Reaching the end
    exits cleanly (return 0).

    A blank line (= raw Enter from tmux send-keys, which is what
    claude-loop's session-start-hook uses to dismiss the picker)
    advances. `quit` on stdin also exits."""
    seq = PROBE_SCENARIOS.get(scenario_name)
    if seq is None:
        sys.stderr.write(
            f"fake-claude: unknown probe scenario '{scenario_name}' "
            f"(available: {', '.join(sorted(PROBE_SCENARIOS))})\n"
        )
        return 2
    idx = 0
    while idx < len(seq):
        slug = seq[idx]
        spec = screens.get(slug)
        if spec is None:
            sys.stderr.write(f"fake-claude: probe scenario '{scenario_name}' references unknown screen '{slug}'\n")
            return 3
        _render_screen_sync(spec)
        idx += 1
        if idx >= len(seq):
            break
        # Wait for the next advance signal. Any line (including blank)
        # advances ; `quit` exits.
        line = sys.stdin.readline()
        if not line:  # EOF
            break
        if line.strip() == "quit":
            break
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="fake-claude",
        description="Scriptable claude(1) simulator for claude-loop debugging (textual TUI ; or --probe-mode for sync stdout / stdin-driven runs in tests).",
    )
    ap.add_argument("scenario", nargs="?", type=Path, help="YAML scenario file (defaults to examples/fake-claude/scenarios/default.yaml next to this binary)")
    ap.add_argument("--list-screens", action="store_true", help="dump built-in screen slugs + exit")
    ap.add_argument("--probe-mode", metavar="NAME", help="#637 Slice 1 — non-TUI probe runner : render a built-in scenario synchronously to stdout, advance on stdin lines. NAME is one of the keys in PROBE_SCENARIOS (--list-probes to list).")
    ap.add_argument("--list-probes", action="store_true", help="#637 Slice 1 — dump built-in probe scenarios + exit.")
    # #982 — fake-claude stands in for `claude` under claude-loop, which ALWAYS
    # appends claude's own flags (`--settings <file>`, `--permission-mode`,
    # `--resume`, …) after our scenario arg. parse_args() would reject those and
    # exit 2 → the tmux pane dies → the loop self-exits. parse_known_args lets us
    # ignore claude's flags (the real positional `scenario` is consumed first).
    args, _claude_flags = ap.parse_known_args()

    if args.list_screens:
        for slug in BUILTIN_SCREENS:
            print(slug)
        return 0

    if args.list_probes:
        for name in sorted(PROBE_SCENARIOS):
            print(f"{name}: {' → '.join(PROBE_SCENARIOS[name])}")
        return 0

    if args.probe_mode:
        return _run_probe_mode(args.probe_mode, BUILTIN_SCREENS)

    scenario = args.scenario or DEFAULT_SCENARIO_PATH

    if not scenario.exists():
        sys.stderr.write(f"fake-claude: {scenario}: no such file\n")
        return 2

    doc = yaml.safe_load(scenario.read_text()) or {}
    # YAML-defined screens override built-ins. Each entry should declare
    # a `kind:` field (header_flash / write / picker / prompt / stream).
    # Legacy `print: "..."` is lifted into `kind: write`.
    yaml_screens = doc.get("screens") or {}
    for slug, scr in yaml_screens.items():
        if "kind" not in scr and "print" in scr:
            scr["kind"] = "write"
            scr["text"] = scr.pop("print")
    screens = {**BUILTIN_SCREENS, **yaml_screens}
    steps = doc.get("steps") or []
    FakeClaudeApp(screens, steps).run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
